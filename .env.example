# ============================================================================
# ENVIRONMENT VARIABLES - Copy this file to .env and fill in your values
# ============================================================================
# SECURITY: Never commit .env to version control. Keep .env in .gitignore.

# Supabase PostgreSQL connection string (server-side only, NEVER use in frontend)
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres

# For SQLAlchemy (Python backend), use this format:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres

# Application secrets (change before deploying to production)
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173

# Optional: Supabase anon/service keys (for Supabase client SDK)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional LLM adapter credentials; never expose in frontend code.
LLM_API_KEY=
LLM_MODEL=
