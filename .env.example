# Local PostgreSQL for running the backend directly on this machine.
# Docker Compose overrides the hostname to `db` for its backend container.
# Point the API at the central admin database. Use the Supabase session pooler
# DSN from the project dashboard; never put this value in frontend configuration.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<database-password>@<session-pooler-host>:5432/admin_db?sslmode=require

# Application secrets
SECRET_KEY=local-development-only-change-before-production
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LLM adapter credentials
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.nugen.in/api/v3
