# Copy to .env and change SECRET_KEY before deploying.
# Supabase server-side connection only. Fill from your secret manager; never use in frontend.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173
# Optional LLM adapter credentials; never expose in frontend code.
LLM_API_KEY=
LLM_MODEL=


